{
  "kind": "collectionType",
  "collectionName": "countries",
  "info": {
    "singularName": "country",
    "pluralName": "countries",
    "displayName": "Country Profile",
    "description": "Country profile with land status, threats, trends, impacts and solutions data"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
